+    /// Defaults to a one-pixel bar with no gap. Uses the normal blink and IME lifecycle.
+    ///
+    /// # Panics
+    /// Panics for a non-finite or non-positive width, or a negative/non-finite gap.
+    pub fn caret_style(mut self, width: Pixels, gap: Pixels) -> Self {
+        assert!(f32::from(width).is_finite() && width >= px(1.));
+        assert!(f32::from(gap).is_finite() && gap >= px(0.));
+        self.caret_width = width;
+        self.caret_gap = gap;
+        self
+    }
+
+    pub(super) fn caret_span(&self) -> Pixels {
+        self.caret_width + self.caret_gap
+    }
